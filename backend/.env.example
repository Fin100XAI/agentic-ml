# Copy to .env and fill in.

# Your Anthropic API key. Without it, the agents fall back to deterministic
# heuristics (the app still runs end-to-end, just without LLM-written commentary).
ANTHROPIC_API_KEY=

# Model the agents use. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# CORS: the frontend dev origin.
FRONTEND_ORIGIN=http://localhost:5173
